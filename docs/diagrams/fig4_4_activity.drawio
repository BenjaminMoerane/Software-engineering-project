<mxfile host="app.diagrams.net" type="device"><diagram id="d1" name="Fig 4.4 Activity diagram — submission to released mark"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="1220" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="UML Activity Diagram with swimlanes — from assignment to released mark (v1.1)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Student" style="swimlane;startSize=30;html=1;horizontal=1;fillColor=#F5F5F5;strokeColor=#999999;fontStyle=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="300" height="1150" as="geometry"/></mxCell><mxCell id="c4" value="System (LMS)" style="swimlane;startSize=30;html=1;horizontal=1;fillColor=#F5F5F5;strokeColor=#999999;fontStyle=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="50" width="300" height="1150" as="geometry"/></mxCell><mxCell id="c5" value="Lecturer" style="swimlane;startSize=30;html=1;horizontal=1;fillColor=#F5F5F5;strokeColor=#999999;fontStyle=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="50" width="300" height="1150" as="geometry"/></mxCell><mxCell id="c6" value="Head of Department" style="swimlane;startSize=30;html=1;horizontal=1;fillColor=#F5F5F5;strokeColor=#999999;fontStyle=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="50" width="300" height="1150" as="geometry"/></mxCell><mxCell id="c7" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="758" y="95" width="24" height="24" as="geometry"/></mxCell><mxCell id="c8" value="Create assignment&lt;br&gt;(deadline UTC, max mark)" style="ro