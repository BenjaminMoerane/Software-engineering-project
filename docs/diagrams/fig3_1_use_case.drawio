3333;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="900" width="170" height="50" as="geometry"/></mxCell><mxCell id="e46" value="" style="endArrow=none;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e47" value="" style="endArrow=none;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e48" value="" style="endArrow=none;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e49" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;exitX=1;exitY=0.25;" edge="1" parent="1" source="c41" target="c43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e50" value="«extend»&lt;br&gt;[before deadline]" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1" source="c44" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e51" value="«extend»&lt;br&gt;[after deadline]" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;exitX=0;exitY=0.5;entryX=1;entryY=0.8;" edge="1" parent="1" source="c45" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c52" value="&lt;b&gt;Note.&lt;/b&gt; &lt;i&gt;Log in&lt;/i&gt; is a precondition of every other use case; it is modelled once on the abstract actor &lt;i&gt;User&lt;/i&gt; and inherited by the four role actors through generalisation. UC-01..03 are the fully dressed use cases." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fillColor=#FFF9DB;strokeColor=#B8A100;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="90" width="290" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>