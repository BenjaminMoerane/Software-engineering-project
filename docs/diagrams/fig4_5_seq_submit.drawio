ative="1" as="geometry"><mxPoint x="1390" y="722" as="sourcePoint"/><mxPoint x="465" y="722" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e30" value='throw "Resubmission is only permitted before the applicable deadline"' style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="790" as="sourcePoint"/><mxPoint x="280" y="790" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e31" value="remove stored copy (no orphan file)" style="html=1;align=left;spacingLeft=4;endArrow=block;endFill=1;rounded=0;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="812" as="sourcePoint"/><mxPoint x="465" y="834" as="targetPoint"/><Array as="points"><mxPoint x="505" y="812"/><mxPoint x="505" y="834"/></Array></mxGeometry></mxCell><mxCell id="e32" value="begin()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="902" as="sourcePoint"/><mxPoint x="1205" y="902" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e33" value="saveVersion(versionNo, submittedAt, contentRef, deadlineUsed, days, classify(days))" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="934" as="sourcePoint"/><mxPoint x="1390" y="934" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e34" value="commit()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="966" as="sourcePoint"/><mxPoint x="1205" y="966" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e35" value="submissionId" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="465" y="996" as="sourcePoint"/><mxPoint x="280" y="996" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=48;height=22;fillColor=none;strokeColor=#555555;fontStyle=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="744" width="1210" height="282" as="geometry"/></mxCell><mxCell id="c37" value="[versionNo &gt; 1 and days &gt; 0]  resubmission after the deadline" style="text;html=1;align=left;fontSize=11;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="384" y="746" width="420" height="18" as="geometry"/></mxCell><mxCell id="e38" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="856" as="sourcePoint"/><mxPoint x="1540" y="856" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="[else]  first submission (on time, late within 3 days, or beyond window), or resubmission on time" style="text;html=1;align=left;fontSize=11;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="384" y="858" width="420" height="18" as="geometry"/></mxCell><mxCell id="e40" value='"Submission file stored and saved (submission ID n)"' style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="1056" as="sourcePoint"/><mxPoint x="95" y="1056" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="classify(days): 0 → OnTime · 1–3 → LateWithinWindow · &amp;gt; 3 → BeyondWindow.&lt;br&gt;The penalty is &lt;b&gt;not&lt;/b&gt; applied here; it is applied once, at marking." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fillColor=#FFF9DB;strokeColor=#B8A100;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="140" width="480" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>