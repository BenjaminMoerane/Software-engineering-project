<mxfile host="app.diagrams.net" type="device"><diagram id="d1" name="Fig 4.3 State machine — Submission life cycle"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="680" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="UML State Machine — Submission life cycle (one current version; mark states driven by marking and HoD moderation)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c3" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="253" y="345" width="24" height="24" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Submitted&lt;/b&gt;&lt;hr size='1'&gt;&lt;div style='text-align:left;font-size:10px'&gt;entry / record server UTC time,&lt;br&gt;deadlineUsed = applicable deadline&lt;br&gt;entry / classify lateStatus:&lt;br&gt;OnTime | LateWithinWindow | BeyondWindow&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;verticalAlign=top;align=center;spacingTop=4;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="180" width="250" height="115" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;PendingModeration&lt;/b&gt;&lt;hr size='1'&gt;&lt;div style='text-align:left;font-size:10px'&gt;raw, penalty, final mark stored&lt;br&gt;(penalty applied once, here)&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;verticalAlign=top;align=center;spacingTop=4;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="190" width="230" height="95" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;ApprovedAwaitingRelease&lt;/b&gt;&lt;hr size='1'&gt;&lt;div style='text-align:left;font-size:10px'&gt;mark locked: lecturer cannot change it&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;verticalAlign=top;align=center;spacingTop=4;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="190" width="240" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Released&lt;/b&gt;&lt;hr size='1'&gt;&lt;div style='text-align:left;font-size:10px'&gt;visible to the student&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;verticalAlign=top;align=center;spacingTop=4;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1320" y="195" width="170" height="70" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;ReturnedForCorrection&lt;/b&gt;&lt;hr size='1'&gt;&lt;div style='text-align:left;font-size:10px'&gt;HoD reason recorded;&lt;br&gt;back in lecturer queue&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;verticalAlign=top;align=center;spacingTop=4;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="450" width="230" height="85" as="geometry"/></mxCell><mxCell id="c9" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1520" y="218" width="26" height="26" as="geometry"/></mxCell><mxCell id="e10" value="submit [enrolled ∧ valid file]" style="endArrow=block;endFill=1;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="resubmit [now ≤ applicable deadline]&lt;br&gt;/ new current version; old superseded" style="endArrow=block;endFill=1;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;exitX=0.25;exitY=0;entryX=0.75;entryY=0;" edge="1" parent="1" source="c4" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="202" y="120"/><mxPoint x="327" y="120"/></Array></mxGeometry></mxCell><mxCell id="e12" value="mark(raw, feedback, reason)&lt;br&gt;/ penalty = strategy(lateness)&lt;br&gt;/ audit row (same transaction)" style="endArrow=block;endFill=1;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="correct mark [no decision yet]&lt;br&gt;/ audit old → new" style="endArrow=block;endFill=1;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;exitX=0.25;exitY=0;entryX=0.75;entryY=0;" edge="1" parent="1" source="c5" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="657" y="125"/><mxPoint x="772" y="125"/></Array></mxGeometry></mxCell><mxCell id="e14" value="HoD approves&lt;br&gt;/ decision + reason" style="endArrow=block;endFill=1;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="HoD returns&lt;br&gt;/ reason" style="endArrow=block;endFill=1;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="715" y="492"/></Array></mxGeometry></mxCell><mxCell id="e16" value="HoD returns" style="endArrow=block;endFill=1;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="492"/></Array></mxGeometry></mxCell><mxCell id="e17" value="lecturer re-marks&lt;br&gt;/ audit" style="endArrow=block;endFill=1;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;exitX=0.25;exitY=0;entryX=0.85;entryY=1;" edge="1" parent="1" source="c8" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="HoD releases&lt;br&gt;[latest decision = Approved]" style="endArrow=block;endFill=1;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="" style="endArrow=block;endFill=1;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;Guards that protect marks&lt;/b&gt;&lt;br&gt;• release only if the latest decision is Approved (FR-17)&lt;br&gt;• an approved mark cannot be changed until returned (defect F3)&lt;br&gt;• after Released, correction is blocked pending OD-08&lt;br&gt;• resubmission after the deadline is refused (F4)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fillColor=#FFF9DB;strokeColor=#B8A100;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="420" height="110" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Open (O-6):&lt;/b&gt; a resubmission before the deadline but after marking creates a new current version while the mark stays on the older one. The intended rule needs an HoD decision." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fillColor=#FFF9DB;strokeColor=#B8A100;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="550" width="420" height="80" as="geometry"/></mxCell><mxCell id="c22" value="BeyondWindow work is kept (not rejected); marking gives final mark 0 (OD-05)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fillColor=#FFF9DB;strokeColor=#B8A100;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="345" width="260" height="50" as="geometry"/></mxCell><mxCell id="e23" value="" style="endArrow=none;dashed=1;html=1;exitX=0.3;exitY=0;entryX=0.9;entryY=1;" edge="1" parent="1" source="c22" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>