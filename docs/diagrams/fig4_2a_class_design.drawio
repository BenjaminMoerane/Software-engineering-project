<mxfile host="app.diagrams.net" type="device"><diagram id="d1" name="Fig 4.2a Class diagram — services, patterns, data access (v1.1)"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Design-level Class Diagram (a) — application services, Strategy and Repository patterns, v1.1  (+ public, − private; «new» = CR1)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&amp;laquo;facade, composition root&amp;raquo;&lt;br&gt;&lt;b&gt;LmsService&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;− tx_ : SqliteTransactionManager&lt;br&gt;− users_, courses_, submissions_, marks_, moderation_ : Sqlite*Repository&lt;br&gt;− penalty_ : ProvisionalLinearPenaltyStrategy&lt;br&gt;− authn_, authz_, …, results_ : (11 services)&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;+ LmsService(db : Database&amp;amp;, clock : function&amp;lt;string()&amp;gt;)&lt;br&gt;+ login(username : string, password : string) : Session&lt;br&gt;+ submitFile(s : Session, assignmentId : int, file : path, dir : path) : int&lt;br&gt;+ markSubmission(s : Session, submissionId : int, raw : double, feedback : string, reason : string) : int&lt;br&gt;+ grantClassExtension(s : Session, assignmentId : int, deadline : string, reason : string) : int «new»&lt;br&gt;… one delegating operation per use case (27 in total)&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;strokeColor=#333333;fillColor=#FFF8E1;" vertex="1" parent="1"><mxGeometry x="560" y="50" width="640" height="190" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Application services&lt;/b&gt;" style="shape=folder;tabWidth=170;tabHeight=22;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fillColor=none;strokeColor=#777777;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="280" width="1430" height="480" as="geometry"/></mxCell><mxCell id="c5" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;b&gt;AuthenticationService&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;− users_ : IUserRepository&amp;amp;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;+ hasAnyUser() : bool&lt;br&gt;+ bootstrapAdministrator(u : string, p : string, name : string) : int&lt;br&gt;+ login(u : string, p : string) : Session&lt;br&gt;«use» PasswordHasher::hash / verify (static)&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="35" y="320" width="340" height="128" as="geometry"/></mxCell><mxCell id="c6" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;b&gt;AuthorizationService&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;− users_ : const IUserRepository&amp;amp;&lt;br&gt;− courses_ : const ICourseRepository&amp;amp;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;+ requireRole(s : Session, r : Role) : void&lt;br&gt;+ requireValidSession(s : Session) : void&lt;br&gt;+ requireLecturerAssigned(lecturerId : int, courseId : int) : void&lt;br&gt;+ isStudentEnrolled(studentId : int, courseId : int) : bool&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="385" y="320" width="340" height="128" as="geometry"/></mxCell><mxCell id="c7" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;b&gt;UserAdministrationService&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;− users_ : IUserRepository&amp;amp;&lt;br&gt;− authz_ : const AuthorizationService&amp;amp;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;+ createUser(s, u, p, name, r : Role, dept : int) : int&lt;br&gt;+ updateUserAccount(s, id : int, name, r : Role, dept : int) : void&lt;br&gt;+ deactivateUser(s : Session, userId : int) : void&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="735" y="320" width="340" height="128" as="geometry"/></mxCell><mxCell id="c8" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;b&gt;CourseService&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;− courses_ : ICourseRepository&amp;amp;&lt;br&gt;− authz_ : const AuthorizationService&amp;amp;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;+ createDepartment(s, name : string) : int&lt;br&gt;+ createCourse(s, dept : int, code, title) : int&lt;br&gt;+ assignLecturer(s, course : int, lecturer : int) : void&lt;br&gt;+ enrolStudent(s, course : int, student : int) : void&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1085" y="320" width="340" height="128" as="geometry"/></mxCell><mxCell id="c9" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;b&gt;AssignmentService&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;− courses_ : ICourseRepository&amp;amp;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;+ createAssignment(s, course : int, title, desc, deadline : string, max : double) : int&lt;br&gt;+ listAssignments(s : Session) : vector&amp;lt;AssignmentView&amp;gt;&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="35" y="465" width="340" height="128" as="geometry"/></mxCell><mxCell id="c10" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;b&gt;ExtensionService&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;− courses_ : ICourseRepository&amp;amp;&lt;br&gt;− authz_ : const AuthorizationService&amp;amp;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;+ grantIndividualExtension(s, a : int, student : int, deadline, reason) : void&lt;br&gt;+ grantClassExtension(s, a : int, deadline : string, reason : string) : int «new»&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;strokeColor=#333333;strokeColor=#1F4E79;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="385" y="465" width="340" height="128" as="geometry"/></mxCell><mxCell id="c11" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;b&gt;SubmissionService&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;− submissions_ : ISubmissionRepository&amp;amp;&lt;br&gt;− tx_ : ITransactionManager&amp;amp;&lt;br&gt;− clock_ : function&amp;lt;string()&amp;gt;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;+ submit(s, assignmentId : int, contentRef : string) : int&lt;br&gt;+ submitFile(s, a : int, source : path, dir : path) : int&lt;br&gt;+ submissionsForMarking(s) : vector&amp;lt;SubmissionView&amp;gt;&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;strokeColor=#333333;strokeColor=#1F4E79;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="735" y="465" width="340" height="128" as="geometry"/></mxCell><mxCell id="c12" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;b&gt;MarkingService&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;− marks_ : IMarkRepository&amp;amp;&lt;br&gt;− tx_ : ITransactionManager&amp;amp;&lt;br&gt;− audit_ : AuditService&amp;amp;&lt;br&gt;− penalty_ : const IPenaltyStrategy&amp;amp;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;+ markSubmission(s, submissionId : int, raw : double, feedback, reason) : int&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1085" y="465" width="340" height="128" as="geometry"/></mxCell><mxCell id="c13" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;b&gt;AuditService&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;− marks_ : IMarkRepository&amp;amp;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;+ recordMarkChange(markId : int, actor : int, old : optional&amp;lt;double&amp;gt;, new : double, reason : string) : void&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="35" y="610" width="340" height="100" as="geometry"/></mxCell><mxCell id="c14" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;b&gt;ModerationService&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;− moderation_ : IModerationRepository&amp;amp;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;+ moderationQueue(s) : vector&amp;lt;ModerationItemView&amp;gt;&lt;br&gt;+ moderate(s, markId : int, approve : bool, reason : string) : void&lt;br&gt;+ release(s : Session, markId : int) : void&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="385" y="610" width="340" height="110" as="geometry"/></mxCell><mxCell id="c15" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;b&gt;ResultQueryService&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;− moderation_ : const IModerationRepository&amp;amp;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;+ releasedResults(s : Session) : vector&amp;lt;ResultView&amp;gt;&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="735" y="610" width="340" height="100" as="geometry"/></mxCell><mxCell id="e16" value="" style="endArrow=none;startArrow=diamondThin;startFill=1;startSize=14;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=1;" edge="1" parent="1" source="c3"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="302" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="◆ composition: owns exactly 1 of each service" style="text;html=1;align=left;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="890" y="250" width="300" height="20" as="geometry"/></mxCell><mxCell id="c18" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&amp;laquo;utility&amp;raquo;&lt;br&gt;&lt;b&gt;DeadlineEvaluator&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;+ toEpochSeconds(iso : string) : int64 {static}&lt;br&gt;+ latenessDays(submitted : string, deadline : string) : int {static}&lt;br&gt;+ classify(days : int) : string {static}&lt;br&gt;+ applicableDeadline(original : string, individual : optional&amp;lt;string&amp;gt;, classWide : optional&amp;lt;string&amp;gt;) : string {static} «new»&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;strokeColor=#333333;strokeColor=#1F4E79;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1490" y="610" width="390" height="140" as="geometry"/></mxCell><mxCell id="c19" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&amp;laquo;interface&amp;raquo;&lt;br&gt;&lt;i&gt;&lt;b&gt;IPenaltyStrategy&lt;/b&gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;+ calculate(latenessDays : int, maximumMark : double) : PenaltyResult {abstract}&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;strokeColor=#333333;fillColor=#EAF2FB;" vertex="1" parent="1"><mxGeometry x="1490" y="300" width="390" height="80" as="geometry"/></mxCell><mxCell id="c20" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;b&gt;ProvisionalLinearPenaltyStrategy&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;+ kWindowDays : int = 3 {readOnly}&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;+ calculate(latenessDays : int, maximumMark : double) : PenaltyResult&lt;br&gt;  10% of max per day, ≤ 3 days; &amp;gt; 3 days → final 0&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1490" y="450" width="390" height="100" as="geometry"/></mxCell><mxCell id="c21" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&amp;laquo;adapter: OpenSSL scrypt&amp;raquo;&lt;br&gt;&lt;b&gt;PasswordHasher&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;+ hash(password : string) : PasswordHash {static}&lt;br&gt;+ verify(password : string, stored : PasswordHash) : bool {static}&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1490" y="60" width="390" height="100" as="geometry"/></mxCell><mxCell id="e22" value="" style="endArrow=block;endFill=0;dashed=1;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1" source="c20" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="«use» Strategy" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="c12" target="c19"><mxGeometry x="0.3" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="«use»" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontFamily=Helvetica;fontSize=12;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.85;entryX=0;entryY=0.35;" edge="1" parent="1" source="c11" target="c18"><mxGeometry x="0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="1075" y="574"/><mxPoint x="1075" y="601"/><mxPoint x="1460" y="601"/><mxPoint x="1460" y="659"/></Array></mxGeometry></mxCell><mxCell id="c25" value="&lt;b&gt;Data access — Repository pattern.&lt;/b&gt; Services depend only on these interfaces; SQL exists only in the Sqlite* classes (enforced by CTest lms_architecture_sql_isolation)." style="text;html=1;align=left;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="770" width="1120" height="24" as="geometry"/></mxCell><mxCell id="c26" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&amp;laquo;interface&amp;raquo;&lt;br&gt;&lt;i&gt;&lt;b&gt;IUserRepository&lt;/b&gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size="1"&gt;&lt;p style="margin:0 0 0 6px;"&gt;+ countUsers() : int&lt;br&gt;+ findCredentials(u : string) : optional&amp;lt;UserCredentials&amp;gt;&lt;br&gt;+ findAccountState(id : int) : optional&amp;lt;AccountState&amp;gt;&lt;br&gt;+ insert(u : NewUser) : int&lt;br&gt;+ deactivate(id : int) : bool&lt;br&gt;+ update(id, name, role, dept) : bool&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;strokeColor=#333333;fillColor=#EAF2FB;" vertex="1" pa