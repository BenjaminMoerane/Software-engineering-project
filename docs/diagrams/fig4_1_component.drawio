<mxfile host="app.diagrams.net" type="device"><diagram id="d1" name="Fig 4.1 Component diagram"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="UML Component Diagram — layered modular monolith (one local process; arrows = dependencies, not network calls)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Presentation layer" style="rounded=0;whiteSpace=wrap;html=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fillColor=#F7F7F7;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1220" height="110" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;«component»&lt;br&gt;Console UI&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;main.cpp · role menus · one handler per option&lt;/font&gt;" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="95" width="340" height="60" as="geometry"/></mxCell><mxCell id="c5" value="Application services layer" style="rounded=0;whiteSpace=wrap;html=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fillColor=#F7F7F7;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="1220" height="190" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;«component»&lt;br&gt;LmsService (facade)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;composition root: wires repositories,&lt;br&gt;strategy and services&lt;/font&gt;" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="225" width="340" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;«component»&lt;br&gt;Use-case services&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Authentication · Authorization · UserAdministration · Course · Assignment&lt;br&gt;Extension · Submission · Marking · Audit · Moderation · ResultQuery&lt;/font&gt;" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="305" width="620" height="64" as="geometry"/></mxCell><mxCell id="c8" value="Domain and policy layer" style="rounded=0;whiteSpace=wrap;html=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fillColor=#F7F7F7;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="590" height="160" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;«component»&lt;br&gt;Domain&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;abstract User + 4 roles · makeUser factory&lt;br&gt;Session · read models&lt;/font&gt;" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="260" height="90" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;«component»&lt;br&gt;Assessment policy&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;DeadlineEvaluator&lt;br&gt;IPenaltyStrategy → Provisional-&lt;br&gt;LinearPenaltyStrategy&lt;/font&gt;" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="440" width="270" height="100" as="geometry"/></mxCell><mxCell id="c11" value="Persistence layer (the only layer that knows SQLite)" style="rounded=0;whiteSpace=wrap;html=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fillColor=#F7F7F7;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="400" width="610" height="290" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;«component»&lt;br&gt;Repository interfaces&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;IUserRepository · ICourseRepository · ISubmissionRepository&lt;br&gt;IMarkRepository · IModerationRepository · ITransactionManager&lt;/font&gt;" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="440" width="570" height="70" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;«component»&lt;br&gt;SQLite repositories&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Sqlite*Repository · Database · RAII Statement / Transaction&lt;br&gt;parameterised SQL · FK on · WAL · schema embedded&lt;/font&gt;" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="590" width="570" height="80" as="geometry"/></mxCell><mxCell id="c14" value="Security adapter" style="rounded=0;whiteSpace=wrap;html=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fillColor=#F7F7F7;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="590" height="110" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;«component»&lt;br&gt;Password hash adapter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;PasswordHasher: salted scrypt, CRYPTO_memcmp&lt;/font&gt;" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontFamily=Helvetica;fontSize=12;" vertex="1" paren